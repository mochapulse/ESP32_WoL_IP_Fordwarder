APP_NAME="lan-controller-esp32"
SSID_WIFI="yourSSID"
PASSWD_WIFI="yourPassword"
# Optional: fixed LAN IP for the ESP32 — disables DHCP on the station.
# Gateway is derived as x.y.z.1 with netmask 255.255.255.0. Omit to use DHCP.
ESP_IP="192.168.1.100"
WEB_PORT=80
WEB_API_TOKEN="change-this-token"
SERVER_WOL_MAC="aa:bb:cc:dd:ee:ff"
BROADCAST_WOL_IP="255.255.255.255"
